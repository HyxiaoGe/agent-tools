# 沙箱执行服务没有密钥要配；下面都是可选的上限，不写用默认值。只放 dev 部署目录的 .env，不入库。

# 每条命令：内存（MB）、CPU（核）、/tmp 内存盘（MB）、沙箱里的进程数、单个文件（MB）
# SANDBOX_MEMORY_MB=1024
# SANDBOX_CPUS=1.0
# SANDBOX_TMP_MB=256
# SANDBOX_NPROC=128
# SANDBOX_FILE_SIZE_MB=256

# 命令没给超时时用多少秒、最多允许多少秒；标准输出、标准错误各留多少字节
# DEFAULT_TIMEOUT_SECONDS=60
# MAX_TIMEOUT_SECONDS=120
# OUTPUT_LIMIT_BYTES=65536

# 同时跑几条命令；排队最多等多少秒
# MAX_CONCURRENT_RUNS=1
# QUEUE_WAIT_SECONDS=20

# 一个工作目录最多占多少磁盘（MB）、多少个目录项；经接口存取的单个文件（MB）；多少天没用就删
# WORKSPACE_LIMIT_MB=1024
# WORKSPACE_MAX_ENTRIES=5000
# MAX_FILE_MB=20
# RETENTION_DAYS=7

# 隔离用的容器运行时，默认 runsc（gVisor）。改成 runc 就没有这一层隔离，只能本机调试用。
# SANDBOX_RUNTIME=runsc
