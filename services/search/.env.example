# Provider
SEARCH_PROVIDER=brave
# 备用链，按顺序尝试，够数即停；留空 = 注册顺序里第一个非主 provider
SEARCH_FALLBACK_PROVIDERS=
BRAVE_API_KEY=your_key_here
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com

# Redis
REDIS_URL=redis://search-redis:6379

# Rate limits
RATE_LIMIT_GLOBAL=40/second
RATE_LIMIT_PER_IP=10/second

# 付费 provider 每日调用上限（北京时间自然日），超额跳过该 provider；未列出的不限，0 表示停用
PROVIDER_DAILY_LIMITS=brave=100,tavily=100,firecrawl=500,deepseek=1000
BUDGET_ALERT_RATIO=0.8
# 额度告警推飞书巡检群；值从 dev 的 ~/.config/feishu-webhooks.env 取，留空只写日志
BUDGET_ALERT_WEBHOOK=
BUDGET_ALERT_SIGN_SECRET=
# 每日用量日报（飞书「AI 成本&额度」群自定义机器人），留空不发；北京时间每天该点后发前一天的汇总
DAILY_REPORT_WEBHOOK=
DAILY_REPORT_SIGN_SECRET=
DAILY_REPORT_HOUR=9

# Cache TTL (seconds)
CACHE_TTL_WEB=600
CACHE_TTL_NEWS=300
CACHE_TTL_IMAGE=1800

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
