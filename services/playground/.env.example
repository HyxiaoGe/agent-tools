# 只在服务端配置，可复用已有产品服务密钥；不放入浏览器或提交到仓库。
PLAYGROUND_GATEWAY_URL=http://agent-tools-gateway:8100
PLAYGROUND_API_KEY=
# 本地开发留空；反向代理或 HTTPS 部署时填写访客实际访问的来源（不含路径和末尾斜杠）。
PLAYGROUND_PUBLIC_ORIGIN=
# 部署时填写 nginx-proxy 在 middleware_default 的实际地址，仅信任受控代理；不要填写 *。
PLAYGROUND_TRUSTED_PROXY_IP=127.0.0.1
PLAYGROUND_REQUESTS_PER_MINUTE=12
PLAYGROUND_REQUESTS_PER_DAY=60
PLAYGROUND_IMAGES_PER_DAY=3
PLAYGROUND_SITE_REQUESTS_PER_DAY=100
PLAYGROUND_SITE_IMAGES_PER_DAY=10
PLAYGROUND_QUOTA_DB_PATH=storage/playground.sqlite3
PLAYGROUND_MAX_CONCURRENT=8
