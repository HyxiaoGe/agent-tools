# 高德、腾讯 Web 服务 key，只放 dev 部署目录的 .env，不入库。和 amap-service、tmap-service 用的是同一把 key。
# 哪把没填，那家就不用；两把都没填时服务照常启动，工具回“查不到”。
AMAP_API_KEY=
TMAP_API_KEY=

# 可选（默认值）
# UPSTREAM_TIMEOUT_SECONDS=8      每次上游请求
# CALL_TIMEOUT_SECONDS=25         整次工具调用
# PROVIDER_CONCURRENCY=3          每家同时最多几个请求
# USAGE_STATE_PATH=               每天的用量计数存哪（compose 里设成 /app/storage/usage.json）
# PORT=8094
