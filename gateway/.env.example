# 产品与服务密钥：密钥只放环境变量，PRODUCTS 里只写变量名。
# 与 image-service 使用同一组产品密钥，调用方一把密钥走所有被放行的服务。
# services 写该产品允许调用的服务；省略时为基础服务 image / search / reader / trends，
# 付费 / 限额服务（amap、context7、weather、flyai、tmap 等）不在默认里，要逐个产品写明。
# daily_limits 可选：该产品对某些服务的每日上限，和下面的 SERVICE_DAILY_LIMITS 总上限同时生效。
PRODUCTS={"fusion":{"service_key_env":"FUSION_SERVICE_KEY","services":["image","search","reader","trends","amap","context7","weather","flyai","tmap"],"daily_limits":{"flyai":50}},"validation":{"service_key_env":"VALIDATION_SERVICE_KEY","services":["search","reader"]}}
FUSION_SERVICE_KEY=
VALIDATION_SERVICE_KEY=

# 上游地址（默认值即 dev 上的部署方式）
# IMAGE_UPSTREAM=http://host.docker.internal:8090
# SEARCH_UPSTREAM=http://search-service:8080
# READER_UPSTREAM=http://reader-service:8091
# TRENDS_UPSTREAM=http://trends-mcp:3333
# AMAP_UPSTREAM=http://amap-mcp:3334
# CONTEXT7_UPSTREAM=http://context7-mcp:3335
# WEATHER_UPSTREAM=http://weather-service:8092
# FLYAI_UPSTREAM=http://flyai-adapter:8093
# TMAP_UPSTREAM=http://tmap-mcp:3336

# 超时与连接池（秒 / 连接数）
# IMAGE_TIMEOUT_SECONDS=180
# SEARCH_TIMEOUT_SECONDS=30
# READER_TIMEOUT_SECONDS=30
# IMAGE_MAX_CONNECTIONS=16
# SEARCH_MAX_CONNECTIONS=32
# READER_MAX_CONNECTIONS=32
# POOL_WAIT_SECONDS=5

# USAGE_DB_PATH=storage/usage.sqlite3
# USAGE_RETENTION_DAYS=90

# 每日用量日报（飞书「AI 成本&额度」群自定义机器人，开签名校验）。webhook 留空则不发。
# 源值在 dev 的 ~/.config/feishu-webhooks.env（FEISHU_AICOST_*）。
DAILY_REPORT_WEBHOOK=
DAILY_REPORT_SIGN_SECRET=
# DAILY_REPORT_HOUR=9
# DAILY_REPORT_STATE_PATH=storage/daily_report_state.json

# 按服务的每日调用上限（北京时间自然日，服务=次数），超出返回 429。不写用默认值，见 README「每日上限」。
# SERVICE_DAILY_LIMITS=search=2000,reader=1000,image=200,weather=1000,amap=1000,tmap=1000,maps=300,flyai=100
# LIMIT_ALERT_RATIO=0.8
# 用到比例和用满时推飞书巡检群（源值在 dev 的 ~/.config/feishu-webhooks.env 的 FEISHU_PATROL_*）；留空只写日志。
LIMIT_ALERT_WEBHOOK=
LIMIT_ALERT_SIGN_SECRET=
